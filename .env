# AI LLM Chatbot Environment Variables

# Port for backend Express server
PORT=5000

# Put your real LLM API key here (Google Gemini API key or OpenAI key)
# Free Google Gemini API Key can be obtained at: https://aistudio.google.com/
LLM_API_KEY=

# Optional: Specific model or provider override (defaults to gemini-2.5-flash)
# LLM_MODEL=gemini-2.5-flash
# LLM_PROVIDER=gemini

# Optional: If you want to use OpenAI or an OpenAI-compatible endpoint (like Groq / OpenRouter)
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1

# Optional: PostgreSQL Connection (only if chat logging to PostgreSQL is required)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/chatdb
